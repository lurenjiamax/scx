# Thor carries upstream v1.1.3 plus the five Pocknix LAVD fixes in Git.
pkgname=scx-scheds
pkgver=1.1.3
pkgrel=3
pkgdesc='sched_ext schedulers and tools with Thor LAVD stability fixes'
arch=(aarch64)
url='https://github.com/sched-ext/scx'
license=(GPL-2.0-only)
depends=(bash bpf libgcc glibc jq libseccomp libbpf libelf protobuf zlib)
makedepends=(clang git llvm llvm-libs python rust)
options=('!lto' '!debug')
source=('https://github.com/jdx/mr-boxington/releases/download/v1.30.0/mbx-aarch64-unknown-linux-gnu.tar.gz')
sha256sums=('6317bb6780404e78c3b670d95e128c85871809dfc541882b2efaa34120f45e71')

build() {
  cd "${THORCH_SCX_SOURCE_DIR:-${startdir}/..}"
  export MBX_GC_AUTO=0 MBX_DISPLAY=plain
  # New ARM64 asm headers need __u128 omitted by libbpf's private types shim.
  export LIBBPF_SYS_EXTRA_CFLAGS="-include /usr/include/linux/types.h ${LIBBPF_SYS_EXTRA_CFLAGS:-}"
  "${srcdir}/mbx" build --release --locked --workspace \
    --exclude scx_rlfifo --exclude scx_mitosis --exclude scx_characterize \
    --exclude xtask --exclude vmlinux_docify --exclude scx_arena_selftests
}

package() {
  cd "${THORCH_SCX_SOURCE_DIR:-${startdir}/..}"
  find "${CARGO_TARGET_DIR:-target}/release" -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "${pkgdir}/usr/bin/" {} +
}
